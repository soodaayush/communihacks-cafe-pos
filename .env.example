# Copy to .env.local. All optional for local dev: the app falls back to mocks.

# Tiger Data (PostgreSQL + TimescaleDB). Service connection string from the downloaded config file.
# Keep both options at the end; without uselibpqcompat Node rejects Tiger's certificate chain.
# Example: postgres://tsdbadmin:PASSWORD@HOST:PORT/tsdb?uselibpqcompat=true&sslmode=require
# NEVER commit the real value. Ask the team lead for it privately.
DATABASE_URL=

# Cloudinary
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Gemini (insights: picks the most important numbers and says them in simple words)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
