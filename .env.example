# Copy to .env.local. All optional for local dev: the app falls back to mocks.

# Tiger Data (PostgreSQL + TimescaleDB). Service connection string, incl. ?sslmode=require
DATABASE_URL=

# Cloudinary
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Gemini (insights: picks the most important numbers and says them in simple words)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
