# Copy to .env.local. All optional for local dev: the app falls back to mocks.

# Tiger Data (PostgreSQL + TimescaleDB). Service connection string from the downloaded config file.
# Keep both options at the end; without uselibpqcompat Node rejects Tiger's certificate chain.
# Example: postgres://tsdbadmin:PASSWORD@HOST:PORT/tsdb?uselibpqcompat=true&sslmode=require
# NEVER commit the real value. Ask the team lead for it privately.
DATABASE_URL=

# Cloudinary
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Gemini (insights: picks the most important numbers and says them in simple words)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# ElevenLabs (the speaker buttons read text aloud in a natural voice). Optional: without a key the
# browser's built-in voice is used. The key stays on the server and is never sent to the browser.
# Create a key at https://elevenlabs.io/app/api/api-keys (text-to-speech is all it needs).
ELEVENLABS_API_KEY=
# A voice from https://elevenlabs.io/app/voice-library: open it and copy its Voice ID.
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
# eleven_flash_v2_5 is fast and half the credits of eleven_multilingual_v2.
ELEVENLABS_MODEL=eleven_flash_v2_5
